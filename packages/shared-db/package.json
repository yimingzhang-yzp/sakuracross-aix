{
  "name": "@sakura-cross/shared-db",
  "version": "0.1.0",
  "private": true,
  "description": "3システム共通の Prisma スキーマ・Prisma Client・Supabase クライアント",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:status": "dotenv -e ../../.env -- prisma migrate status",
    "push": "dotenv -e ../../.env -- prisma db push",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "format": "prisma format",
    "validate": "prisma validate",
    "db:local": "tsx scripts/local-db.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supabase/supabase-js": "^2.100.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^22.18.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "dotenv": "^17.0.0"
  }
}
