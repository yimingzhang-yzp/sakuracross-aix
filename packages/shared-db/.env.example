
# -----------------------------------------------------------------------------
# シフト給与(apps/shift-payroll)固有
# -----------------------------------------------------------------------------
# 管理画面の初期管理者(カンマ区切りメール)。Staff.authUserId 未設定でも ADMIN として入れる
ADMIN_EMAILS=
# LIFF の ID トークン検証に使うチャネル ID(LINE Developers > LIFF を追加したチャネルの「チャネルID」)。
# 未設定かつ非本番では x-dev-line-user-id ヘッダ / ?dev_user= で開発用ユーザーを指定できる
LINE_STAFF_LIFF_CHANNEL_ID=
# スタッフ用 Webhook で受けた AI上司宛てイベントの転送先(ai-boss の内部 API)。未設定ならログのみ
AI_BOSS_INTERNAL_URL=http://localhost:3002/api/internal/line-event
