# =============================================================================
# CROSS ROPPONGI 業務システム群 — 環境変数テンプレート
#
# 使い方: このファイルをコピーして `.env` を作り、値を埋める(`.env` は git 管理外)。
#   cp .env.example .env
#
# ・すべてのアプリ(apps/*)はモノレポルートの .env を読み込む(next.config.ts で dotenv 経由)。
#   アプリ固有に上書きしたい場合は apps/<app>/.env.local に書く(そちらが優先)。
# ・Prisma CLI(migrate 等)も dotenv-cli でこのファイルを参照する。
# ・「未設定でも動く」項目は空のままで OK。該当機能はモック/スキップにフォールバックする。
# ・本番(Vercel)では Project Settings > Environment Variables に同じキーを登録する。
# =============================================================================

# -----------------------------------------------------------------------------
# 実行環境
# -----------------------------------------------------------------------------
NODE_ENV=development

# 各アプリの公開 URL(LINE 通知に載せる管理画面リンク、LIFF のエンドポイント設定に使用)
NEXT_PUBLIC_APP_URL_SHIFT_PAYROLL=http://localhost:3001
NEXT_PUBLIC_APP_URL_AI_BOSS=http://localhost:3002
NEXT_PUBLIC_APP_URL_INVOICE=http://localhost:3003

# -----------------------------------------------------------------------------
# Supabase(PostgreSQL / Auth / Storage)— 1 プロジェクトを 3 システムで共有
#
# 取得方法: https://supabase.com/dashboard → 対象プロジェクト
#   ・DATABASE_URL / DIRECT_URL: Project Settings > Database > Connection string
#       - DATABASE_URL: "Transaction" モード(ポート 6543)の URI に `?pgbouncer=true&connection_limit=1` を付ける
#                        → サーバーレス(Vercel)からのアプリ接続用
#       - DIRECT_URL:   "Session" モードまたは Direct connection(ポート 5432)の URI
#                        → prisma migrate 用(pgbouncer 経由では DDL が失敗するため)
#       [YOUR-PASSWORD] は Project Settings > Database > Database password でリセット可
#   ・NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY:
#       Project Settings > API(anon = 公開可、service_role = サーバー専用・絶対に公開しない)
# 未設定時: DB 接続をスキップし /api/health は db.status="skipped" で 200 を返す
# -----------------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage バケット名(請求書原本 / ナレッジ取込ファイル)。Supabase Dashboard > Storage で作成(非公開バケット)
SUPABASE_STORAGE_BUCKET_INVOICES=invoices
SUPABASE_STORAGE_BUCKET_KNOWLEDGE=knowledge-uploads

# -----------------------------------------------------------------------------
# LINE 公式アカウント ①「CROSS スタッフ」(全スタッフ向け: シフト給与 + AI上司)
#
# 取得方法: https://developers.line.biz/console/ → プロバイダー → Messaging API チャネル
#   ・チャネルシークレット:        「チャネル基本設定」タブ
#   ・チャネルアクセストークン:    「Messaging API設定」タブ → チャネルアクセストークン(長期)を発行
#   ・Webhook URL:                 「Messaging API設定」→ https://<shift-payroll のドメイン>/api/line/webhook
#                                  (1 チャネル 1 URL。shift-payroll が受けて ai-boss へ振り分ける)
#   ・LIFF ID:                     同チャネルの「LIFF」タブ → 追加(エンドポイント URL は各 LIFF ページ)
# 注意: 無料プランは月 200 通。スタッフ 30 名規模ではコミュニケーションプラン(月 5,000 通)以上を契約
# 未設定時: 署名検証をスキップ(開発時のみ)、送信はモック(ログ出力のみ)
# -----------------------------------------------------------------------------
LINE_STAFF_CHANNEL_SECRET=
LINE_STAFF_CHANNEL_ACCESS_TOKEN=
LINE_STAFF_LIFF_ID_PREFERENCE=
LINE_STAFF_LIFF_ID_SCHEDULE=
LINE_STAFF_LIFF_ID_TIMECLOCK=
LINE_STAFF_LIFF_ID_PAYSLIP=

# -----------------------------------------------------------------------------
# LINE 公式アカウント ②「CROSS 管理」(店長・経理・オーナー向け: 請求書 + 運用アラート)
#
# 取得方法: ①と同じ手順で別チャネルを作成
#   ・Webhook URL: https://<invoice のドメイン>/api/line/webhook
#   ・LINE_ADMIN_NOTIFY_TO: 通知先。グループに Bot を招待した場合は groupId、1:1 なら userId
#       (Webhook の event.source.groupId / userId をログで確認して転記)
# -----------------------------------------------------------------------------
LINE_ADMIN_CHANNEL_SECRET=
LINE_ADMIN_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_NOTIFY_TO=

# -----------------------------------------------------------------------------
# Anthropic API(AI上司の回答生成 / 請求書 OCR・抽出 / 取引先名寄せ)
#
# 取得方法: https://console.anthropic.com/ → API Keys → Create Key
# 未設定時: AI 呼び出しはモック応答にフォールバック(実装は各アプリのフェーズ1で追加)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# 埋め込み API(AI上司フェーズ2以降の pgvector 用。フェーズ1は全文検索のため任意)
# 取得方法: https://dash.voyageai.com/ → API keys
VOYAGE_API_KEY=

# -----------------------------------------------------------------------------
# 請求書メール取込(apps/invoice)
#
# メール受信基盤(Cloudflare Email Routing → Worker / Resend / SendGrid Inbound Parse)から
# /api/inbound/email へ POST する際の共有シークレット。任意の長いランダム文字列を生成して双方に設定
#   例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
INVOICE_INBOUND_EMAIL_SECRET=
INVOICE_INBOUND_EMAIL_ADDRESS=invoice@example.com

# -----------------------------------------------------------------------------
# アプリ間の内部 API 認証(shift-payroll が受けた LINE Webhook を ai-boss へ転送する際の共有シークレット)
# 任意の長いランダム文字列を生成し、3 アプリすべてに同じ値を設定する
#   例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
INTERNAL_API_SECRET=

# -----------------------------------------------------------------------------
# AI上司(apps/ai-boss)固有
#
#   ADMIN_EMAILS               管理画面にログインできるメールアドレス(カンマ区切り)。
#                              Staff.authUserId + accessRole=ADMIN の紐付けが無い初期管理者のブートストラップ用
#   SHIFT_PAYROLL_INTERNAL_URL 「CROSS スタッフ」の Webhook は ai-boss が直接受ける(ASSUMPTIONS.md Q1)。
#                              shift: 宛ての postback / follow を shift-payroll へ転送する先(例 https://shift.example.com)。
#                              未設定なら転送せずログのみ(shift-payroll 実装前はこのままで OK)
#   AI_BOSS_SKIP_AUTO_SEED     DATABASE_URL 未設定時のメモリストアへ knowledge_seed を自動投入しない場合 1
# -----------------------------------------------------------------------------
ADMIN_EMAILS=
SHIFT_PAYROLL_INTERNAL_URL=
AI_BOSS_SKIP_AUTO_SEED=

# -----------------------------------------------------------------------------
# Vercel Cron 認証
#
# Vercel が cron 実行時に `Authorization: Bearer <CRON_SECRET>` を付けるための値。
# Vercel Dashboard > Project > Settings > Environment Variables に CRON_SECRET を登録すると自動付与される。
# ローカルでは任意の文字列で OK
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# 監視・ログ(任意)
# -----------------------------------------------------------------------------
LOG_LEVEL=info
